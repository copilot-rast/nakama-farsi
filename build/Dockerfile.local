ARG NEXUS_DOCKER_HOST=docker.arvancloud.ir
ARG GO_IMAGE=${NEXUS_DOCKER_HOST}/library/golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0
ARG DEBIAN_IMAGE=${NEXUS_DOCKER_HOST}/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

FROM ${GO_IMAGE} AS builder

ENV GOOS=linux
ENV CGO_ENABLED=1

WORKDIR /go/build/nakama

ARG GIT_COMMIT=
ARG GIT_BRANCH=
ARG GIT_DIRTY=
ARG GIT_OWN_AHEAD=
ARG BUILD_DATE=

COPY . .

RUN sh build/buildinfo.sh > /go/buildinfo.ldflags && cat /go/buildinfo.ldflags | tr ' ' '\n' | grep -v '^-X$' | grep -v 'Upstream=' | sed 's/^/buildinfo: /'
RUN --mount=type=cache,target=/root/.cache/go-build go build -o /go/build-out/nakama -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "-s -w -X main.version=local $(cat /go/buildinfo.ldflags)"
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/base.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/base
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/economy.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/economy
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/inventoryx.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/inventoryx
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/publication.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/publication
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/devkit.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/devkit
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/leaderboardx.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/leaderboardx
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/content.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/content
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/insights.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/insights
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/quiz.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/quiz
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/trophy.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/trophy
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/clan.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/clan
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/cup.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/cup
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/campaign.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/campaign
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/assets.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/assets
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/itemkinds.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/itemkinds
RUN --mount=type=cache,target=/root/.cache/go-build go run -mod=vendor ./tools/rpcschema -root . -openapi /go/build-out/modules/openapi.json -buildflag=-buildmode=plugin -buildflag=-trimpath -buildflag=-mod=vendor "-buildflag=-gcflags=-trimpath $PWD" "-buildflag=-asmflags=-trimpath $PWD"
RUN --mount=type=cache,target=/root/.cache/go-build go build -buildmode=plugin -o /go/build-out/modules/stargame.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./samples/stargame

FROM ${DEBIAN_IMAGE}

LABEL MAINTAINER="Heroic Labs <support@heroiclabs.com>"

ARG version

LABEL version=$version
LABEL variant=nakama
LABEL description="Distributed server for social and realtime games and apps."

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
RUN mkdir -p /nakama/data/modules /nakama/uploads

WORKDIR /nakama/
COPY --from=builder "/go/build-out/nakama" /nakama/
COPY --from=builder "/go/build-out/modules/" /nakama/data/modules/
COPY --chmod=755 build/nakama-db.sh build/nakama-start.sh /nakama/
VOLUME /nakama/uploads
EXPOSE 7349 7350 7351 7353 9100

ENTRYPOINT ["/nakama/nakama-start.sh"]

HEALTHCHECK --interval=30s --timeout=10s \
  CMD /nakama/nakama healthcheck || exit 1

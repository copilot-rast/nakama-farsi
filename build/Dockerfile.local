# docker build .. -f Dockerfile.local -t nakama:dev

FROM golang:1.27.3-bookworm AS builder

ENV GOOS=linux
ENV CGO_ENABLED=1

# No apt here or in the runtime stage: deb.debian.org is unreachable from servers
# in Iran. golang:*-bookworm already ships gcc, libc6-dev, ca-certificates and tzdata.

WORKDIR /go/build/nakama

ARG GIT_COMMIT=
ARG GIT_BRANCH=
ARG GIT_DIRTY=
ARG GIT_OWN_AHEAD=
ARG BUILD_DATE=

COPY . .

RUN sh build/buildinfo.sh > /go/buildinfo.ldflags && cat /go/buildinfo.ldflags | tr ' ' '\n' | grep -v '^-X$' | grep -v 'Upstream=' | sed 's/^/buildinfo: /'
RUN go build -o /go/build-out/nakama -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "-s -w -X main.version=local $(cat /go/buildinfo.ldflags)"
RUN go build -buildmode=plugin -o /go/build-out/modules/jazebe.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/jazebe/native
RUN go build -buildmode=plugin -o /go/build-out/modules/base.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/base
RUN go build -buildmode=plugin -o /go/build-out/modules/economy.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/economy
RUN go build -buildmode=plugin -o /go/build-out/modules/publication.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./integrations/publication
RUN go build -buildmode=plugin -o /go/build-out/modules/stargame.so -trimpath -mod=vendor -gcflags "-trimpath $PWD" -asmflags "-trimpath $PWD" -ldflags "$(cat /go/buildinfo.ldflags)" ./samples/stargame

FROM debian:bookworm-slim

LABEL MAINTAINER="Heroic Labs <support@heroiclabs.com>"

ARG version

LABEL version=$version
LABEL variant=nakama
LABEL description="Distributed server for social and realtime games and apps."

# CA certificates and time zones come from the builder (same Debian release), so
# the image builds without any package download. psql is not included: it is only
# needed for the one-time CockroachDB import (DB_IMPORT_FROM_COCKROACH=true).
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
RUN mkdir -p /nakama/data/modules /nakama/uploads

WORKDIR /nakama/
COPY --from=builder "/go/build-out/nakama" /nakama/
COPY --from=builder "/go/build-out/modules/" /nakama/data/modules/
COPY --chmod=755 build/nakama-db.sh build/nakama-start.sh /nakama/
VOLUME /nakama/uploads
EXPOSE 7349 7350 7351 7353 9100

# nakama-start.sh execs Nakama, which then runs as PID 1 and handles SIGTERM itself.
ENTRYPOINT ["/nakama/nakama-start.sh"]

HEALTHCHECK --interval=30s --timeout=10s \
  CMD /nakama/nakama healthcheck || exit 1

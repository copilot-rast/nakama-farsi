{
  "note": "Every native class the spatial overlay depends on. npm run check fails when one disappears from the console bundle (CSS or JS) or when spatial CSS uses a native class that is not listed here. routes/min are checked by e2e 10-spatial-visual.",
  "own": "^(sp|dark|open|sp-.+|eco-.+|ps-.+|setup-.+|brand-.+|economy-.+|l10n-.+)$",
  "selectors": [
    {
      "id": "shell-drawer",
      "what": ".x-drawer (rail source) and its sidebar wrapper",
      "selector": "div.flex.border-r.z-20:has(> .x-drawer) .x-drawer .grid a[href]",
      "classes": [
        "x-drawer",
        "x-scroll",
        "flex",
        "border-r",
        "z-20",
        "grid"
      ],
      "routes": [
        "#/"
      ],
      "min": 1
    },
    {
      "id": "shell-topbar",
      "what": "#main > div.sticky:first-child top bar: breadcrumb holder, stats, user menu",
      "selector": "#main > div.sticky:first-child .justify-end",
      "classes": [
        "sticky",
        "flex-1",
        "w-full",
        "justify-end",
        "hidden",
        "md:flex",
        "text-xs",
        "x-divider",
        "x-popover",
        "x-button",
        "lg:hidden",
        "router-link-active"
      ],
      "routes": [
        "#/"
      ],
      "min": 1
    },
    {
      "id": "layout-page",
      "what": "page body wrapper, header and container",
      "selector": "#main div.max-w-\\[1600px\\]",
      "classes": [
        "max-w-[1600px]",
        "mb-4",
        "relative",
        "x-container",
        "flex-col",
        "gap-4",
        "px-4",
        "py-3"
      ],
      "routes": [
        "#/players"
      ],
      "min": 1
    },
    {
      "id": "card",
      "what": "card / window recipe",
      "selector": "#main .rounded-md.shadow.bg-white",
      "classes": [
        "rounded-md",
        "shadow",
        "bg-white",
        "overflow-hidden",
        "dark:bg-secondary-800"
      ],
      "routes": [
        "#/",
        "#/players"
      ],
      "min": 1
    },
    {
      "id": "table",
      "what": "native tables",
      "selector": "#main .x-table-head",
      "classes": [
        "x-table-head",
        "x-table-header",
        "overflow-x-scroll",
        "text-center"
      ],
      "routes": [
        "#/players",
        "#/runtime"
      ],
      "min": 1
    },
    {
      "id": "text-roles",
      "what": "text colour roles mapped to ink and status tokens",
      "selector": "#main .text-secondary-500",
      "classes": [
        "text-secondary-400",
        "text-secondary-500",
        "text-secondary-600",
        "text-secondary-700",
        "text-secondary-800",
        "text-secondary-900",
        "text-success-500",
        "text-success-600",
        "text-error-500",
        "text-error-600",
        "text-error-700",
        "text-warning-500",
        "text-warning-600",
        "text-warning-700",
        "text-primary-500",
        "text-primary-600",
        "text-primary-700",
        "text-green-500",
        "text-red-500",
        "text-red-600",
        "dark:text-secondary-50",
        "dark:text-secondary-100",
        "dark:text-secondary-200",
        "dark:text-secondary-300",
        "dark:text-secondary-400",
        "dark:text-secondary-500",
        "text-2xl",
        "text-xl",
        "text-lg",
        "text-sm",
        "font-medium",
        "font-semibold",
        "placeholder-secondary-400"
      ],
      "routes": [
        "#/players"
      ],
      "min": 0
    },
    {
      "id": "surfaces",
      "what": "surface roles mapped to wells and lines",
      "selector": "#main .bg-secondary-100",
      "classes": [
        "bg-secondary-50",
        "bg-secondary-100",
        "bg-secondary-200",
        "bg-secondary-300",
        "bg-[#fcfcfc]",
        "border",
        "border-b",
        "border-t",
        "border-l",
        "border-dashed",
        "divide-y",
        "border-secondary-100",
        "border-secondary-200",
        "border-secondary-300",
        "h-12",
        "w-12",
        "rounded-full",
        "shiki",
        "even:bg-secondary-50"
      ],
      "routes": [
        "#/players/00000000-0000-0000-0000-000000000000"
      ],
      "min": 0
    },
    {
      "id": "controls",
      "what": "inputs, selects, toggles, labels, alerts, uploads",
      "selector": "#main input.appearance-none",
      "classes": [
        "appearance-none",
        "x-select",
        "x-toggle",
        "border-[3px]",
        "x-label",
        "x-alert",
        "x-upload",
        "bg-primary-500"
      ],
      "routes": [
        "#/players"
      ],
      "min": 1
    },
    {
      "id": "button-link-tag",
      "what": "buttons, links, tags, badges",
      "selector": "#main .x-button",
      "classes": [
        "x-button",
        "x-link",
        "x-tag",
        "x-badge"
      ],
      "routes": [
        "#/players"
      ],
      "min": 1
    },
    {
      "id": "tabs",
      "what": "tab groups",
      "selector": "#main .x-tab-group .x-tab",
      "classes": [
        "x-tab-group",
        "x-tab",
        "x-tooltip",
        "min-w-full",
        "w-fit",
        "pointer-events-none",
        "absolute",
        "h-[2px]",
        "router-link-exact-active"
      ],
      "routes": [
        "#/players/00000000-0000-0000-0000-000000000000"
      ],
      "min": 1
    },
    {
      "id": "panel",
      "what": "teleported side panel (Vue transition classes redefined)",
      "selector": "div.fixed.inset-0.flex.justify-end > .x-form",
      "classes": [
        "fixed",
        "inset-0",
        "justify-end",
        "x-form",
        "translate-x-full",
        "duration-300",
        "duration-400",
        "bg-secondary-900",
        "opacity-60",
        "p-4",
        "!absolute",
        "shadow-lg",
        "z-10",
        "transform"
      ],
      "routes": [],
      "min": 0
    },
    {
      "id": "modal-popover-toast",
      "what": "modals, poppers, tooltips, toasts",
      "selector": ".v-popper__popper",
      "classes": [
        "v-popper__popper",
        "v-popper__inner",
        "v-popper__wrapper",
        "v-popper__arrow-container",
        "v-popper__popper--shown",
        "x-notifications",
        "x-modal",
        "opacity-0",
        "top-2",
        "contents",
        "text-xl"
      ],
      "routes": [],
      "min": 0
    },
    {
      "id": "skeleton-charts-editor",
      "what": "skeletons, charts and Monaco",
      "selector": "#main [_echarts_instance_]",
      "classes": [
        "animate-pulse",
        "monaco-editor",
        "monaco-editor-background",
        "overflow-guard"
      ],
      "routes": [
        "#/"
      ],
      "min": 0
    },
    {
      "id": "auth",
      "what": "login, password reset and MFA reset layout (form column, logo, release feed)",
      "selector": "#app > div.relative.flex.min-h-screen .sm\\:w-\\[512px\\]",
      "classes": [
        "min-h-screen",
        "justify-center",
        "lg:absolute",
        "sm:w-[512px]",
        "flex-1",
        "overflow-hidden"
      ],
      "routes": [
        "#/login"
      ],
      "min": 1
    },
    {
      "id": "dashboard",
      "what": "dashboard KPI grid, chart cards and live badge",
      "selector": "#main .grid.xl\\:grid-cols-5 > .rounded-md.shadow.bg-white",
      "classes": [
        "xl:grid-cols-5",
        "md:grid-cols-2",
        "h-60",
        "items-center",
        "justify-between",
        "x-input-footer"
      ],
      "routes": [
        "#/"
      ],
      "min": 5
    }
  ]
}
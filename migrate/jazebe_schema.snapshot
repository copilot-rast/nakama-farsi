index jazebe_user_report uq_jazebe_profile_report_open CREATE UNIQUE INDEX uq_jazebe_profile_report_open ON public.jazebe_user_report USING btree (planet_id, reporter_user_id, subject_type, subject_id) WHERE (((status)::text = 'open'::text) AND ((subject_type)::text = 'profile'::text))
index jazebe_user_report uq_jazebe_user_report_open CREATE UNIQUE INDEX uq_jazebe_user_report_open ON public.jazebe_user_report USING btree (planet_id, reporter_user_id, subject_type, subject_id) WHERE (((status)::text = ANY ((ARRAY['open'::character varying, 'reviewing'::character varying])::text[])) AND ((subject_type)::text = ANY ((ARRAY['message'::character varying, 'group'::character varying])::text[])))

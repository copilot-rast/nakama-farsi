index jazebe_user_profile uq_jazebe_user_profile_name CREATE UNIQUE INDEX uq_jazebe_user_profile_name ON public.jazebe_user_profile USING btree (lower((display_name)::text))
index jazebe_user_report idx_jazebe_user_report_planet_queue CREATE INDEX idx_jazebe_user_report_planet_queue ON public.jazebe_user_report USING btree (planet_id, status, created_at DESC, id DESC)
index jazebe_user_report idx_jazebe_user_report_queue CREATE INDEX idx_jazebe_user_report_queue ON public.jazebe_user_report USING btree (status, created_at DESC, id DESC)

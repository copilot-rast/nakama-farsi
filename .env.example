# --- PostgreSQL ---------------------------------------------------------------
# Used by nakama-migrate and nakama. The bundled postgres service is created
# with the same DB_NAME, DB_USER and DB_PASSWORD on the first start of its
# volume; changing them later does not change an existing role or password.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nakama
DB_USER=nakama
DB_PASSWORD=change-me

# Empty uses Nakama's default (prefer: TLS when the server offers it).
# For a database reached over a network you do not control, use verify-full
# and DB_SSL_ROOT_CERT (a CA file path inside the containers).
DB_SSL_MODE=
DB_SSL_ROOT_CERT=

# Optional complete address, which replaces all the DB_* fields above for the
# Nakama services (not for the bundled postgres). Encode special characters in
# the user and password, e.g. @ as %40.
# DB_URL=postgresql://nakama:change-me@db.example.com:5432/nakama?sslmode=verify-full
DB_URL=

# How long the services wait for the database to resolve and accept
# connections before failing.
DB_WAIT_TIMEOUT_SECONDS=120

# --- Migrations ---------------------------------------------------------------
# false skips `nakama migrate up`; the server then refuses to start while
# migrations are pending.
DB_MIGRATIONS_ENABLED=true

# --- One-time import of the legacy CockroachDB data -------------------------------
# true: copy the legacy CockroachDB database into an empty PostgreSQL once,
# then never again. A new installation without CockroachDB data sets false.
DB_IMPORT_FROM_COCKROACH=false
COCKROACH_IMPORT_URL=

# Set to cockroach-import only if Compose should (re)create the legacy
# cockroachdb container on its existing data volume.
COMPOSE_PROFILES=

# --- Nakama -------------------------------------------------------------------
NAKAMA_SERVER_KEY=ed61f3a9b57a8d2ef1cf589445fe3bc7c6305711e427d92d11cea61f0fc051b0
NAKAMA_SESSION_ENCRYPTION_KEY=8d1ce28a5ac224c24449977cd2e43a2752b0b4b31f3fe9d00edbcd1d0199e3f5
NAKAMA_REFRESH_ENCRYPTION_KEY=d942402ca755d717906944e18bc2b5c1f8c970f609e0fb45632f73eb78e3f512
NAKAMA_RUNTIME_HTTP_KEY=35f64c6bcd34b71562ef8ff70d8c13afadc11b11d0391713502e3f4f53580de8
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=Admin1234
NAKAMA_CONSOLE_SIGNING_KEY=d2dede74604743d9bbc203e19df6d116e9f4bb6cfc4ce8c8e233a8e933477ed4

# --- Economy and publication modules --------------------------------------------
# 48+ random hex characters (openssl rand -hex 24). Encrypts gateway and SMS/email
# secrets and signs payment callbacks; changing it makes saved secrets unreadable.
ECONOMY_SECRET_KEY=
# Public address of the Nakama API, used for payment callbacks and uploaded files.
ECONOMY_PUBLIC_BASE_URL=https://nakama.dastar.dev
# Where the browser goes after a bank payment. Empty uses ECONOMY_DEEP_LINK.
# For the stargame sample served locally: http://localhost:7470/?payment={paymentId}&success={success}
ECONOMY_WEB_REDIRECT_URL=
ECONOMY_DEEP_LINK=nakama://payment?success={success}&paymentId={paymentId}

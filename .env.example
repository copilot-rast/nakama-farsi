# --- PostgreSQL ---------------------------------------------------------------
# Used by nakama-migrate and nakama. The bundled postgres service is created
# with the same DB_NAME, DB_USER and DB_PASSWORD on the first start of its
# volume; changing them later does not change an existing role or password.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nakama
DB_USER=nakama
DB_PASSWORD=change-me

# Empty uses Nakama's default (prefer: TLS when the server offers it).
# For a database reached over a network you do not control, use verify-full
# and DB_SSL_ROOT_CERT (a CA file path inside the containers).
DB_SSL_MODE=
DB_SSL_ROOT_CERT=

# Optional complete address, which replaces all the DB_* fields above for the
# Nakama services (not for the bundled postgres). Encode special characters in
# the user and password, e.g. @ as %40.
# DB_URL=postgresql://nakama:change-me@db.example.com:5432/nakama?sslmode=verify-full
DB_URL=

# How long the services wait for the database to resolve and accept
# connections before failing.
DB_WAIT_TIMEOUT_SECONDS=120

# --- Migrations ---------------------------------------------------------------
# false skips `nakama migrate up`; the server then refuses to start while
# migrations are pending.
DB_MIGRATIONS_ENABLED=true

# --- One-time import of the legacy CockroachDB data -------------------------------
# true: copy the legacy CockroachDB database into an empty PostgreSQL once,
# then never again. A new installation without CockroachDB data sets false.
DB_IMPORT_FROM_COCKROACH=false
COCKROACH_IMPORT_URL=

# Set to cockroach-import only if Compose should (re)create the legacy
# cockroachdb container on its existing data volume.
COMPOSE_PROFILES=

# --- Nakama -------------------------------------------------------------------
NAKAMA_SERVER_KEY=replace-with-openssl-rand-hex-32
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
NAKAMA_REFRESH_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
NAKAMA_RUNTIME_HTTP_KEY=replace-with-openssl-rand-hex-32
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=change-me
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-openssl-rand-hex-32

# --- Economy and publication modules --------------------------------------------
# 32+ characters (openssl rand -hex 24). Encrypts gateway and SMS/email secrets
# and signs payment callbacks. Empty uses NAKAMA_SESSION_ENCRYPTION_KEY (the
# economy derives its own keys from it with HKDF). Changing this value later, or
# changing NAKAMA_SESSION_ENCRYPTION_KEY while this is empty, makes the saved
# gateway and SMS/email secrets unreadable: enter them again in the console.
ECONOMY_SECRET_KEY=
# Public address of the Nakama API, used for payment callbacks and uploaded files.
ECONOMY_PUBLIC_BASE_URL=https://api.example.com
# Where the browser goes after a bank payment. Empty in .env uses the compose
# default, the Star Catcher sample served by Nakama:
# https://api.example.com/stargame/?payment={paymentId}&success={success}
ECONOMY_WEB_REDIRECT_URL=
ECONOMY_DEEP_LINK=nakama://payment?success={success}&paymentId={paymentId}

# --- Uploaded files (console image uploads) -------------------------------------
# local: files go to ECONOMY_UPLOAD_DIR (the economy-uploads volume). Fine for
# one node. s3: files go to an S3-compatible bucket (AWS S3, MinIO, ...) that
# every node shares; use it before running more than one Nakama node.
STORAGE_DRIVER=local
# Example for MinIO: http://minio:9000 (no path).
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# true: http://endpoint/bucket/key (MinIO). false: http://bucket.endpoint/key.
STORAGE_S3_PATH_STYLE=true
# Empty: Nakama streams files from the bucket at /v2/economy/files/{name} with
# its own safety headers. Set (e.g. a CDN in front of the bucket) to answer that
# URL with a 302 to {base}/{prefix}economy/{name} instead.
STORAGE_S3_PUBLIC_BASE_URL=
# Optional folder inside the bucket, e.g. prod.
STORAGE_S3_PREFIX=

# --- Star Catcher sample (/stargame/ on the API port) ---------------------------
# true: on start, create the sample's languages, coin, shop, gift codes and
# sandbox payment methods if they are missing. Never changes existing rows.
STARGAME_SEED=true

# --- Cluster (off by default) -------------------------------------------------
# true runs every nakama container as a node of one cluster that shares
# presence, matchmaking and logouts through Redis; see docs/cluster-design.md.
# Also set COMPOSE_PROFILES=cluster (starts the redis service) and
# STORAGE_DRIVER=s3, then scale with `docker compose up --scale nakama=3`.
NAKAMA_CLUSTER_ENABLED=false
# Unique per node, at most 16 characters. Empty: the container hostname.
NAKAMA_NODE_NAME=
NAKAMA_CLUSTER_REDIS_ADDRESS=redis:6379
NAKAMA_CLUSTER_REDIS_PASSWORD=
NAKAMA_CLUSTER_REDIS_MAXMEMORY=1gb
# Empty: the container IP.
NAKAMA_CLUSTER_ADVERTISE_ADDRESS=
# Empty: NAKAMA_SESSION_ENCRYPTION_KEY.
NAKAMA_CLUSTER_SECRET=
NAKAMA_CLUSTER_MATCHMAKER_SHARDS=16
# A string ticket property (for example mode or region) that splits
# matchmaking into pools spread over the nodes. Empty: one pool.
NAKAMA_CLUSTER_MATCHMAKER_SHARD_PROPERTY=
